# --- Supabase ---
# Found in Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-only, NEVER expose to the browser. Used for the
# monthly invoice-generation job and admin user-role bootstrap.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of your deployed app (no trailing slash). Used to build Billplz
# callback/redirect URLs. For local dev use a tunnel (e.g. ngrok) so Billplz
# can reach your callback endpoint, since http://localhost is not reachable
# from Billplz's servers.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Billplz ---
# "sandbox" while testing, "production" when you go live. Sandbox and
# production are SEPARATE Billplz accounts with separate credentials/URLs.
BILLPLZ_ENV=sandbox
BILLPLZ_API_KEY=your-billplz-api-secret-key
BILLPLZ_COLLECTION_ID=your-billplz-collection-id
BILLPLZ_X_SIGNATURE_KEY=your-billplz-x-signature-key

# --- Cron ---
# Shared secret required as a Bearer token / ?secret= query param when
# calling /api/cron/generate-invoices, so only your scheduler can trigger it.
CRON_SECRET=choose-a-long-random-string
